{
  "openapi": "3.0.3",
  "info": { "title": "kumo游服 API", "version": "0.8.1" },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "ClaimReq": {
        "type": "object",
        "required": ["activity_id", "uid", "stage"],
        "properties": {
          "activity_id": { "type": "integer" },
          "uid": { "type": "string" },
          "stage": { "type": "integer" }
        }
      }
    }
  },
  "security": [{ "bearer": [] }],
  "paths": {
    "/api/login": {
      "post": {
        "summary": "玩家登录，校验平台 token 后下发游戏会话",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "device_id"],
                "properties": { "token": { "type": "string" }, "device_id": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "/api/activity/claim": {
      "post": {
        "summary": "领取活动阶段奖励（每个阶段仅可领取一次）",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClaimReq" } } } }
      }
    },
    "/api/mail/list": {
      "get": {
        "summary": "查询玩家邮件列表",
        "parameters": [
          { "name": "uid", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ]
      }
    },
    "/api/mail/{mail_id}/claim": {
      "post": {
        "summary": "领取邮件附件",
        "parameters": [{ "name": "mail_id", "in": "path", "required": true, "schema": { "type": "string" } }]
      }
    }
  }
}
