/**
 * 应用调用关系（mock）。
 *
 * 节点 = 应用 / 外部调用方 / 平台服务 / 数据存储；边 = 一条调用关系，并落到具体 API。
 * 每条边说明「谁调了谁的哪些接口、走公网还是内网、用什么凭证、依据是什么」，
 * 这样既能看到应用间的关联，也能回答「每个 API 是被谁调用的」。
 *
 * 真实实现的数据来源：
 * - 入向：Ingress / SLB 访问日志的来源（玩家、支付平台、办公网 IP 段）
 * - 出向：解析代码里的 HTTP 客户端调用 + 配置中的目标地址（如 http://kumo-game:8080）
 * - 数据：代码里的数据库 / 缓存连接与 SQL 表名
 * - 凭证：调用时携带的 key 与凭证扫描结果交叉比对
 */

import type { HttpMethod, RiskLevel } from './types'

export type GraphNodeKind = 'external' | 'app' | 'platform' | 'data'

export interface GraphNode {
  id: string
  name: string
  desc: string
  kind: GraphNodeKind
  /** 画布坐标（节点中心） */
  x: number
  y: number
}

/** 边上调用的接口：registered 表示该接口在 API 清单中，可点开详情 */
export interface EdgeApi {
  method: HttpMethod | 'SQL' | 'CMD'
  path: string
  /** API 清单中的 id（被调方是本游戏应用时） */
  apiId: string | null
  desc: string
}

export interface GraphEdge {
  id: string
  from: string
  to: string
  label: string
  via: '公网' | '内网'
  apis: EdgeApi[]
  /** 调用时携带的凭证 */
  credential: string | null
  /** 这条调用本身的风险（与接口风险分开：如共用凭证、绕过游戏服直接写库） */
  risk: RiskLevel
  riskReason: string
  /** 判断依据 */
  evidence: string
}

export const NODE_W = 168
export const NODE_H = 60

export const graphNodes: GraphNode[] = [
  { id: 'office', name: '运营人员', desc: '办公网 / 外网', kind: 'external', x: 140, y: 70 },
  { id: 'player', name: '玩家', desc: '客户端', kind: 'external', x: 480, y: 70 },
  { id: 'payment', name: '支付平台', desc: '到账回调', kind: 'external', x: 780, y: 70 },
  { id: 'admin-data', name: 'admin-data', desc: 'GM 平台', kind: 'app', x: 140, y: 260 },
  { id: 'kumo', name: 'kumo游服', desc: '游戏服', kind: 'app', x: 560, y: 260 },
  { id: 'cfgplt', name: 'cfgplt', desc: '配表平台', kind: 'app', x: 950, y: 260 },
  { id: 'center', name: 'center', desc: '平台：帐号 / 支付', kind: 'platform', x: 140, y: 450 },
  { id: 'mysql', name: 'MySQL', desc: '玩家 / 订单 / 邮件', kind: 'data', x: 560, y: 450 },
  { id: 'redis', name: 'Redis', desc: '在线 / 缓存', kind: 'data', x: 860, y: 450 }
]

